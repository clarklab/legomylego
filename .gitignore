.cache/
__pycache__/
*.pyc
.venv/
node_modules/
models/*/out/frames/
models/*/out/tmp/
.DS_Store
models/_sample/out/
*.egg-info/
models/*/out/video_frames/
models/*/out/variants/*/video_frames/
models/*/out/video_*.mp4
models/*/out/variants/*/video_*.mp4
# render intermediates (deliverables in out/ stay tracked)
models/*/out/**/scene.json
models/*/out/booklet/
models/*/out/**/booklet/
models/*/out/**/cover_render/
.claude/
models/*/out/*.tmp.mp4
models/*/out/turntable_frames/
models/*/out/turntable_preview.mp4
showreel/work/
# Quick Bricks: the rendered frames and previews stay out (the finished SLUG-WxH.mp4 is tracked)
models/*/out/quick_frames/
models/*/out/quick_preview.mp4
models/*/out/*_preview.mp4
# scratch models (experiments), all but the tests' sample
models/_*/
!models/_sample/
# LEGO's own instruction booklets (reference copies) stay local: the repo is public
docs/references/**/*.pdf
docs/references/*.zip
# new models waiting to be taken in: local only (docs/new-model.md); and whole instruction
# files never go in a model's reference/ either (the repo is public)
inbox/*
!inbox/README.md
models/*/reference/*.pdf
models/*/reference/*.io
models/*/reference/*.zip
# character art a model was worked out from, of unknown source: kept local
models/jake_the_dog/reference/
models/bulbasaur/reference/*.webp
models/bulbasaur/reference/*.jpeg
models/charmander_starter/reference/*.webp
models/charmander_starter/reference/*.jpeg
models/squirtle/reference/*.webp
models/squirtle/reference/*.jpeg
models/guardian/reference/*.jpg
