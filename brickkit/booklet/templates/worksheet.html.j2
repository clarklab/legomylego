<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ title }}: sorting sheet</title>
<style>
  @page { size: {{ page_w }}mm {{ page_h }}mm; margin: {{ margin }}mm; }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body { font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; color: #1c1c1c; font-size: 10pt; line-height: 1.28; }
  h1 { font-size: 21pt; line-height: 1.05; margin: 0 0 1.6mm; letter-spacing: -0.01em; }
  .kicker { font-size: 8pt; letter-spacing: 0.14em; text-transform: uppercase; color: #8a6d00; margin: 0 0 1.5mm; display: flex; justify-content: space-between; align-items: baseline; }
  .kicker .small { font-size: 6.5pt; letter-spacing: 0; text-transform: none; color: #888; }
  .intro { display: flex; gap: 6mm; align-items: flex-start; }
  .intro .words { flex: 1; }
  .intro img { width: 38mm; height: 38mm; object-fit: contain; background: #eef2f7; border-radius: 3mm; }
  .lead { margin: 0 0 2mm; font-size: 10.5pt; }
  ul.facts { margin: 0; padding: 0; list-style: none; }
  ul.facts li { margin: 0 0 1.2mm; padding-left: 5mm; position: relative; }
  ul.facts li::before { content: ""; position: absolute; left: 0; top: 1.4mm; width: 2.4mm; height: 2.4mm; border-radius: 50%; background: #f5c400; }
  .sources { font-size: 7pt; color: #777; margin: 1mm 0 0; }
  .how { display: flex; gap: 4mm; margin: 2.4mm 0 1.6mm; padding: 2mm 4mm; background: #fff6cc; border-radius: 2.5mm; font-size: 9.5pt; }
  .how div { flex: 1; display: flex; gap: 2mm; align-items: flex-start; }
  .how b.n { flex: none; width: 6.5mm; height: 6.5mm; border-radius: 50%; background: #1c1c1c; color: #fff; font-size: 10pt; display: flex; align-items: center; justify-content: center; }
  .check { display: flex; align-items: center; gap: 3mm; font-size: 8pt; color: #555; margin: 0 0 2.4mm; }
  .check .rule { flex: none; width: 50mm; height: 3mm; border-left: 0.3mm solid #1c1c1c; border-right: 0.3mm solid #1c1c1c; background: linear-gradient(#1c1c1c, #1c1c1c) center / 100% 0.3mm no-repeat; }
  .mat { columns: 2; column-gap: {{ gutter }}mm; }
  .cell { display: inline-block; vertical-align: top; break-inside: avoid; border: 0.3mm solid #d9d9d9; border-radius: 2.5mm; padding: 1.2mm 2.2mm 1.8mm; margin: 0 1.2mm 1.8mm 0; }
  .tag { display: flex; align-items: center; gap: 1.8mm; margin: 0 0 1mm; min-height: 7mm; }
  .tag img { flex: none; max-height: 7mm; max-width: 14mm; }
  .tag b { font-size: 15pt; line-height: 1; }
  .tag .what { font-size: 8.5pt; line-height: 1.15; }
  .tag .what i { display: block; font-style: normal; color: #666; font-size: 7.5pt; }
  .tag .chip { flex: none; width: 3.2mm; height: 3.2mm; border-radius: 50%; border: 0.25mm solid #999; }
  .spots { display: grid; gap: 2mm; align-items: center; justify-items: start; justify-content: start; }
  .spots svg { display: block; overflow: visible; }
  .spots polygon { stroke: #444; stroke-width: 0.3; stroke-dasharray: 1.3 0.9; stroke-linejoin: round; }
</style>
</head>
<body>
<p class="kicker"><span>Sorting sheet &middot; {{ pieces }} pieces</span><span class="small">{{ name }} &middot; an unofficial fan-made sheet, not a LEGO product &middot; {{ site }}</span></p>
<div class="intro">
  <div class="words">
    <h1>{{ title }}</h1>
    {% if lead %}<p class="lead">{{ lead }}</p>{% endif %}
    {% if facts %}<ul class="facts">{% for f in facts %}<li>{{ f }}</li>{% endfor %}</ul>{% endif %}
    {% if sources %}<p class="sources">{{ sources }}</p>{% endif %}
  </div>
  {% if cover %}<img src="{{ cover }}" alt="">{% endif %}
</div>
<div class="how">
  <div><b class="n">1</b><span>Find each piece in the big bucket. The picture shows what to look for.</span></div>
  <div><b class="n">2</b><span>Put it on its outline. Every outline gets one piece.</span></div>
  <div><b class="n">3</b><span>No outline left empty? You have a whole set. Start building!</span></div>
</div>
<div class="check"><span class="rule"></span><span>This line is 5 cm long. If yours is not, print the sheet again at 100% (&ldquo;actual size&rdquo;), so the pieces fit their outlines.</span></div>
<div class="mat">
{% for r in rows %}
  <div class="cell">
    <div class="tag">
      {% if r.img %}<img src="booklet/{{ r.img }}" alt="">{% endif %}
      <b>{{ r.qty }}&times;</b>
      <span class="chip" style="background: {{ r.hex }}"></span>
      <span class="what">{{ r.name }}<i>{{ r.colour }}</i></span>
    </div>
    <div class="spots" style="grid-template-columns: repeat({{ r.across }}, {{ r.w }}mm)">
      {% for k in range(r.qty) %}<svg width="{{ r.w }}mm" height="{{ r.h }}mm" viewBox="0 0 {{ r.w }} {{ r.h }}"><polygon points="{{ r.points }}" fill="{{ r.tint }}"/></svg>{% endfor %}
    </div>
  </div>
{% endfor %}
</div>
</body>
</html>
