0 FILE ferret.ldr
0 Ferret
0 Name: ferret.ldr
0 Author: brickkit

0 // Stand the chest on its front legs
1 16 0 0 0 1 0 0 0 1 0 0 0 1 chest.ldr
0 STEP
0 // Stand the hips on their hind legs behind it, then lower the arched back onto both
1 16 0 0 0 1 0 0 0 1 0 0 0 1 back.ldr
1 16 0 0 0 1 0 0 0 1 0 0 0 1 hips.ldr
0 STEP
0 // Set the head on the turntable in the white throat and turn it 20 degrees to look at you: it can be turned 15 degrees the other way or 30 this way
1 16 0 0 180 0.939693 0 0.34202 0 1 0 -0.34202 0 0.939693 head.ldr
0 STEP
0 // Plug the tail onto the eight side studs at the rump
1 16 0 -212 1000 1 0 0 0 0 1 0 -1 0 tail.ldr
0 STEP
0 NOFILE

