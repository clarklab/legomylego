0 FILE dinosaur.ldr
0 Mini T. rex
0 Name: dinosaur.ldr
0 Author: brickkit

0 // Set the left completed leg upright on the table
1 16 0 0 0 1 0 0 0 1 0 0 0 1 left_leg.ldr
0 STEP
0 // Set the right completed leg upright on the table
1 16 0 0 0 1 0 0 0 1 0 0 0 1 right_leg.ldr
0 STEP
0 // Lock the two hip halves together with an orange plate extending into the tail
1 25 0 -54 30 0 0 1 0 1 0 -1 0 0 3020.dat
0 STEP
0 // The inverted orange belly widens toward the chest; red tail slopes taper backward
1 25 -10 -78 20 1 0 0 0 1 0 0 0 1 3665b.dat
1 25 10 -78 20 1 0 0 0 1 0 0 0 1 3665b.dat
1 4 -10 -78 40 -1 0 0 0 1 0 0 0 -1 3040b.dat
1 4 10 -78 40 -1 0 0 0 1 0 0 0 -1 3040b.dat
