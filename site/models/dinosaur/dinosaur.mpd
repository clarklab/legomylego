0 // A red shoulder handle with free outer ends, and a red rear plate
1 4 0 -86 0 1 0 0 0 1 0 0 0 1 2540.dat
1 4 0 -86 20 1 0 0 0 1 0 0 0 1 3023b.dat
0 STEP
0 // Clip the arms onto the outer shoulder-bar ends, hands curving forward
1 4 -16 -84 -20 1 0 0 0 1 0 0 0 1 30377.dat
1 4 16 -84 -20 1 0 0 0 1 0 0 0 1 30377.dat
0 STEP
0 // Orange neck above the front row of the body
1 25 0 -110 0 1 0 0 0 1 0 0 0 1 3004.dat
0 STEP
0 // The flat red lower jaw extends forward from the neck
1 4 0 -118 -30 0 0 1 0 1 0 -1 0 0 3020.dat
0 STEP
0 // Only one white round plate per tooth; two orange plates form the rear mouth support
1 15 -10 -126 -60 1 0 0 0 1 0 0 0 1 6141.dat
1 15 10 -126 -60 1 0 0 0 1 0 0 0 1 6141.dat
1 25 0 -126 0 1 0 0 0 1 0 0 0 1 3023b.dat
1 25 0 -134 0 1 0 0 0 1 0 0 0 1 3023b.dat
0 STEP
0 // A thin red upper jaw spans the mouth
1 4 0 -142 -30 0 0 1 0 1 0 -1 0 0 3020.dat
0 STEP
0 // A one-plate-high skull row: red snout, black eyes, orange rear
1 4 0 -150 -50 1 0 0 0 1 0 0 0 1 3022.dat
1 0 -10 -150 -20 1 0 0 0 1 0 0 0 1 6141.dat
1 0 10 -150 -20 1 0 0 0 1 0 0 0 1 6141.dat
1 25 0 -150 0 1 0 0 0 1 0 0 0 1 3023b.dat
0 STEP
0 // Support the curved forehead; finish with a low red crown
1 4 0 -158 -40 1 0 0 0 1 0 0 0 1 3023b.dat
1 4 0 -150 -50 1 0 0 0 1 0 0 0 1 15068.dat
1 4 0 -158 -10 1 0 0 0 1 0 0 0 1 3022.dat
1 4 0 -166 -10 1 0 0 0 1 0 0 0 1 3068b.dat
0 STEP
