1 0 0 -34 4 0 0 -1 0 1 0 1 0 0 32062.dat
0 STEP
0 // Push a second cross-hole brick, right way up, onto the axle's long end, and put the little slope on it, high edge to the front
1 71 0 -44 20 1 0 0 0 1 0 0 0 1 73230.dat
1 71 0 -44 20 -1 0 0 0 1 0 0 0 -1 54200.dat
0 STEP
