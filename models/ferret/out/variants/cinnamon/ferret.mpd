0 FILE ferret.ldr
0 Ferret
0 Name: ferret.ldr
0 Author: brickkit

0 // Stand the chest on its front legs
1 16 0 0 0 1 0 0 0 1 0 0 0 1 chest.ldr
0 STEP
0 // Set the hips beside it and lower the back onto both
1 16 0 0 0 1 0 0 0 1 0 0 0 1 back.ldr
1 16 0 0 0 1 0 0 0 1 0 0 0 1 hips.ldr
0 STEP
0 // Set the head on the throat
1 16 0 0 0 1 0 0 0 1 0 0 0 1 head.ldr
0 STEP
0 // Plug the tail into the rump
1 16 0 -212 1000 1 0 0 0 0 1 0 -1 0 tail.ldr
0 STEP
0 NOFILE

